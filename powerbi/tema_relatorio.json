{
  "name": "Templates WordPress - Analytics",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "background": "#f4f5f7",
  "foreground": "#2b2b29",
  "tableAccent": "#2a78d6",
  "good": "#2a78d6",
  "bad": "#eb6834",
  "neutral": "#b4b3ad",
  "maximum": "#123f75",
  "center": "#9cc2ef",
  "minimum": "#eef4fc",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#2b2b29" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#2b2b29" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#6b6b66" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#2b2b29" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e1e3e8" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#f4f5f7" } }, "transparency": 0 }] }
    }
  }
}
